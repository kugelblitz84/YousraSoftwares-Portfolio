# Absolute public origin of the deployed site, with no trailing slash.
# Used for metadataBase (Open Graph / Twitter card URLs), sitemap.xml, and robots.txt.
# Falls back to http://localhost:3000 when unset, so this MUST be set in production
# or the sitemap will advertise localhost URLs to search engines.
NEXT_PUBLIC_SITE_URL=https://yusrasoftwares.com
